# 统一文本文件以 LF 检出:Windows  runners 默认 core.autocrlf=true,
# CRLF 转换会改变文件字节数,使 static/vendor 的字节清单校验
# (tests/test_css_contract.py)在 Windows 上必然失败。
* text=auto eol=lf

# Windows 批处理保留 CRLF,避免老版本 cmd 解析问题。
*.bat text eol=crlf

# 二进制资源显式声明,不参与行尾转换。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.terrain binary
*.tif binary
*.tiff binary
*.db binary
